<?xml version="1.0" encoding="utf-8"?>
<!-- The server is a LAN NAS that normally serves plain HTTP; allow cleartext to any host. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- InsecureBaseConfiguration: the owner explicitly allows arbitrary LAN hosts (2026-10-20); see README code exceptions. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
